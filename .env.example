# Local model for low-RAM development/testing
MODEL_NAME=your_model_name
OLLAMA_BASE_URL=http://localhost:11434

# auto = one-call fast pipeline for <=2B models; quality pipeline for larger models
PERFORMANCE_MODE=auto

# Long enough for cold starts on low-RAM machines
OLLAMA_TIMEOUT=900
OLLAMA_RETRIES=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.15
